{
  "contractVersion": 2,
  "apiPrefix": "FixturePatchbay",
  "descriptorImport": "package:patchbay/patchbay.dart",
  "permissions": ["fixtureAccess"],
  "cancellations": ["fixtureStop"],
  "profiles": {
    "job": {
      "mode": "job",
      "sideEffect": "external",
      "factSources": ["appRecorded"],
      "gates": ["fixture.ready"]
    }
  },
  "commands": [
    {
      "id": "fixtureRun",
      "name": "fixture.run",
      "summary": "Run fixture",
      "profile": "job",
      "permissions": ["fixtureAccess"],
      "cancellation": "fixtureStop",
      "parameters": [
        {"name": "count", "type": "integer", "default": 3},
        {"name": "secret", "type": "string", "sensitive": true}
      ]
    }
  ]
}
