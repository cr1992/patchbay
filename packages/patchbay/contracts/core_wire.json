        {"name": "value", "type": "String", "nullable": true},
        {"name": "destinationId", "type": "String", "nullable": true},
        {"name": "navigationRevision", "type": "int", "nullable": true},
        {"name": "treeRevision", "type": "int", "nullable": true},
        {"name": "frameRevision", "type": "int"}
