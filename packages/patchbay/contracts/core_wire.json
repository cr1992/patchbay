      "name": "PatchbaySideEffectWire",
      "values": ["none", "appState", "external"]
    },
    {
      "kind": "enum",
      "name": "PatchbayFactSourceWire",
      "values": ["appRecorded", "commandEcho", "deviceReported", "uiObserved", "unknown"]
    },
    {
      "kind": "enum",
      "name": "PatchbayAdmissionWire",
      "values": ["accepted", "rejected"]
    },
    {
      "kind": "enum",
      "name": "PatchbayJobPhaseWire",
      "values": ["running", "completed", "failed", "cancelled"]
